-- Helper Functions
local function Draw(Type, Properties)
	local drawing = Drawing.new(Type)
	for k, v in pairs(Properties or {}) do
		drawing[k] = v
	end
	return drawing
end

local function Connecter(Signal, Callback)
	return Signal:Connect(Callback)
end

local function WorldToViewPoint(Part)
	if not Part then return Vector3.zero, false end
	local Pos, OnScreen = CurrentCamera:WorldToViewportPoint(Part.Position)
	return Vector2.new(Pos.X, Pos.Y), OnScreen
end

local function IsAlive(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return hum and hum.Health > 0
end

local function SortAttribute(item)
	return {"", "", "", "", "Amount"}
end

local function getBallisticFlightTime(Vector, Gravity, Speed)
	return Vector.Magnitude / Speed
end

local function PredictPosition(TargetPos, TargetVel, TravelTime, Gravity)
	return TargetPos + (TargetVel * TravelTime) + (0.5 * Gravity * (TravelTime ^ 2))
end

local function IsBehindWall(Origin, TargetPos)
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {Character}
	local ray = workspace:Raycast(Origin, TargetPos - Origin, raycastParams)
	return ray and ray.Instance and not ray.Instance:IsDescendantOf(Character)
end

